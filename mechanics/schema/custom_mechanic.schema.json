{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom game mechanic extension",
  "type": "object",
  "required": ["id", "version", "title", "patches"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^custom\\.[a-z][a-z0-9._-]*$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "engine_status": {
      "enum": ["ruleset_patch", "design_only", "planned"]
    },
    "patches": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "boolean", "array", "object", "null"]
      }
    },
    "design_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatible_rulesets": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
