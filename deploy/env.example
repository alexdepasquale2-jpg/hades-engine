# Copy to deploy/.env for docker compose

TBC_NATS_URL=nats://nats:4222
TBC_NATS_STREAM=TBC_RWW
TBC_ARCHIVE_PATH=/data/tbc-archive.db

# Production TLS for QUIC gateway (paths inside container)
TBC_TLS_CERT=/tls/cert.pem
TBC_TLS_KEY=/tls/key.pem
# Optional mTLS — require client certs signed by this CA
# TBC_TLS_CLIENT_CA=/tls/client-ca.pem
